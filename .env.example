# Canonical origin of the site. Used for canonical URLs, Open Graph tags,
# the sitemap and the RSS feeds — set this in the Vercel project settings too.
NEXT_PUBLIC_SITE_URL=https://tonoyan.dev

# Optional: raises the GitHub API rate limit when resolving repository cards.
GITHUB_TOKEN=

ESLINT_NO_DEV_ERRORS=true
ANALYZE=false

# Resend API key for contact form emails
# Get it from: resend.com/api-keys
# Or auto-injected via Vercel Marketplace integration
RESEND_API_KEY=
